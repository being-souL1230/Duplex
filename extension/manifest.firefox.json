{
  "manifest_version": 3,
  "name": "FocusFlow",
  "version": "0.1.0",
  "description": "Context switching killer — detects your work context and restores it in one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "focusflow@hackdevengers.dev",
      "strict_min_version": "113.0"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FocusFlow"
  },
  "background": {
    "scripts": ["background/firefox-entry.js"],
    "type": "module"
  },
  "permissions": ["tabs", "storage", "cookies", "idle", "alarms"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
